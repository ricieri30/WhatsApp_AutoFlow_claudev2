# ──────────────────────────────────────────────────────────────
# WhatsApp AutoFlow Claude v2 - modelo de variaveis de ambiente
# Copie para .env e preencha. O .env real NAO e versionado no Git.
#   cp .env.example .env && nano .env
# ──────────────────────────────────────────────────────────────

# Nome do projeto Docker Compose. MANTENHA este valor: os nomes de
# container, network e volumes da producao dependem dele. Sem isso,
# um 'docker compose up' sem -p cria uma stack duplicada/orfa.
COMPOSE_PROJECT_NAME=autoflow_claude_2v

NODE_ENV=production

# Segredo de assinatura dos tokens JWT. Gere um valor longo e aleatorio,
# por exemplo: openssl rand -hex 32
JWT_SECRET=troque-por-um-segredo-aleatorio-longo

# Credenciais do admin inicial (a senha pode ser alterada depois no app).
ADMIN_EMAIL=admin@admin.com
ADMIN_PASSWORD=troque-esta-senha

# Dominio para HTTPS automatico via Caddy (deixe :80 para HTTP local).
SITE_ADDRESS=:80

# Mensagens de aviso de vencimento (use {{nome}} para o primeiro nome).
NOTICE_7D=Ola {{nome}}! Sua assinatura vence em 7 dias.
NOTICE_1D=Atencao {{nome}}! Sua assinatura vence amanha.
NOTICE_TODAY=Ola {{nome}}! Sua assinatura expira hoje.

# Ritmo de envio das mensagens (anti-bloqueio).
MIN_MESSAGE_DELAY_MS=2000
JITTER_MS=1000
